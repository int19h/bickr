{
	"name": "bickr",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler pages deploy dist/client --project-name=bickr",
		"dev": "npm run build && wrangler pages dev dist/client",
		"dev:ui": "vite",
		"preview": "npm run build && wrangler pages dev dist/client",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.15.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "~6.0.2",
		"vite": "^8.0.10",
		"vitest": "^4.1.5",
		"wrangler": "^4.85.0"
	}
}
