{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr-agent-runtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": ["enable_request_signal"],
	"durable_objects": {
		"bindings": [
			{
				"name": "BOT_RUNTIME",
				"class_name": "BotRuntime"
			},
			{
				"name": "USER_BOTS",
				"class_name": "UserBotsCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BotRuntime"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["UserBotsCoordinator"]
		}
	],
	"kv_namespaces": [
		{ "binding": "BICKR_KV", "id": "bickr-local-kv" }
	],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"preview_database_id": "BICKR_D1",
			"migrations_dir": "../../migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "BICKR_R2", "bucket_name": "bickr-avatars" }
	],
	"vars": {
		"BICKR_R2_PUBLIC_BASE_URL": "https://assets.bickr.social"
	},
	// Workers AI and Vectorize are intentionally omitted from the default local config.
	// They force Wrangler remote proxy startup in local dev; production deploys use wrangler.deploy.jsonc.
	"services": [
		{
			"binding": "FORUM_COORDINATOR_SERVICE",
			"service": "bickr-forum-coordinator"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"env": {
		"test": {
			"name": "bickr-agent-runtime-test",
			"durable_objects": {
				"bindings": [
					{
						"name": "BOT_RUNTIME",
						"class_name": "BotRuntime"
					},
					{
						"name": "USER_BOTS",
						"class_name": "UserBotsCoordinator"
					}
				]
			},
			"kv_namespaces": [
				{ "binding": "BICKR_KV", "id": "f153e4189e40485488cbbe0ca4ba91eb" }
			],
			"d1_databases": [
				{
					"binding": "BICKR_D1",
					"database_name": "bickr-test",
					"database_id": "d45193d4-15af-461d-84e7-9f8c276a30f8",
					"migrations_dir": "../../migrations"
				}
			],
			"r2_buckets": [
				{ "binding": "BICKR_R2", "bucket_name": "bickr-avatars-test" }
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "BICKR_SEARCH_VECTORIZE",
					"index_name": "bickr-bot-search-test"
				},
				{
					"binding": "BICKR_BOT_VECTORIZE",
					"index_name": "bickr-bot-search-test"
				}
			],
			"vars": {
				"BICKR_R2_PUBLIC_BASE_URL": "https://assets-test.bickr.social",
				"OPENROUTER_MODEL": "openrouter/free"
			},
			"services": [
				{
					"binding": "FORUM_COORDINATOR_SERVICE",
					"service": "bickr-forum-coordinator-test"
				}
			],
			"triggers": {
				"crons": ["*/5 * * * *"]
			}
		}
	}
}
