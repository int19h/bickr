{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr-agent-runtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": ["enable_request_signal"],
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "BOT_RUNTIME",
				"class_name": "BotRuntime"
			},
			{
				"name": "USER_BOTS",
				"class_name": "UserBotsCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BotRuntime"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["UserBotsCoordinator"]
		}
	],
	"kv_namespaces": [
		{ "binding": "BICKR_KV", "id": "bickr-local-kv" }
	],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"preview_database_id": "BICKR_D1",
			"migrations_dir": "../../migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "BICKR_R2", "bucket_name": "bickr-avatars" }
	],
	"vars": {
		"BICKR_R2_PUBLIC_BASE_URL": "https://assets.bickr.social"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "BICKR_SEARCH_VECTORIZE",
			"index_name": "bickr-bot-search"
		},
		{
			"binding": "BICKR_BOT_VECTORIZE",
			"index_name": "bickr-bot-search"
		}
	],
	"services": [
		{
			"binding": "FORUM_COORDINATOR_SERVICE",
			"service": "bickr-forum-coordinator"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
