// Rollback phase 2. Production commits the reverse transfer to test.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr-forum-coordinator",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"exports": {
		"ForumCoordinator": { "type": "durable-object", "state": "transferred", "transferred_to": "bickr-forum-coordinator-test" },
		"WorldCoordinator": { "type": "durable-object", "state": "transferred", "transferred_to": "bickr-forum-coordinator-test" },
	},
	"durable_objects": {
		"bindings": [
			{ "name": "FORUM_COORDINATOR", "class_name": "ForumCoordinator", "script_name": "bickr-forum-coordinator-test" },
			{ "name": "WORLD_COORDINATOR", "class_name": "WorldCoordinator", "script_name": "bickr-forum-coordinator-test" },
		],
	},
	"kv_namespaces": [{ "binding": "BICKR_KV", "id": "f153e4189e40485488cbbe0ca4ba91eb" }],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-test",
			"database_id": "d45193d4-15af-461d-84e7-9f8c276a30f8",
			"migrations_dir": "../../migrations",
		},
	],
}
