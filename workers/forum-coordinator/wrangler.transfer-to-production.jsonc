// Maintenance-only source commit. Deploying this transfers both namespaces to
// production atomically and deliberately omits daily scheduled maintenance.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr-forum-coordinator-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"exports": {
		"ForumCoordinator": {
			"type": "durable-object",
			"state": "transferred",
			"transferred_to": "bickr-forum-coordinator",
		},
		"WorldCoordinator": {
			"type": "durable-object",
			"state": "transferred",
			"transferred_to": "bickr-forum-coordinator",
		},
	},
	"durable_objects": {
		"bindings": [
			{ "name": "FORUM_COORDINATOR", "class_name": "ForumCoordinator", "script_name": "bickr-forum-coordinator" },
			{ "name": "WORLD_COORDINATOR", "class_name": "WorldCoordinator", "script_name": "bickr-forum-coordinator" },
		],
	},
	"kv_namespaces": [{ "binding": "BICKR_KV", "id": "f153e4189e40485488cbbe0ca4ba91eb" }],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-test",
			"database_id": "d45193d4-15af-461d-84e7-9f8c276a30f8",
			"migrations_dir": "../../migrations",
		},
	],
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "BICKR_SEARCH_VECTORIZE", "index_name": "bickr-bot-search-test" }],
}
