{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr-forum-coordinator",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"workers_dev": false,
	"preview_urls": false,
	// INTERNAL_SERVICE_SECRET is a Worker secret set with `wrangler secret put`.
	// Do not place it in vars; it is intentionally not in secrets.required so
	// deploys can roll out before the secret exists.
	"durable_objects": {
		"bindings": [
			{
				"name": "WORLD_COORDINATOR",
				"class_name": "WorldCoordinator"
			},
			{
				"name": "FORUM_COORDINATOR",
				"class_name": "ForumCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ForumCoordinator"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["WorldCoordinator"]
		}
	],
	"kv_namespaces": [
		{ "binding": "BICKR_KV", "id": "bickr-local-kv" }
	],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"preview_database_id": "BICKR_D1",
			"migrations_dir": "../../migrations"
		}
	],
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"env": {
		"test": {
			"name": "bickr-forum-coordinator-test",
			"workers_dev": false,
			"preview_urls": false,
			"durable_objects": {
				"bindings": [
					{
						"name": "WORLD_COORDINATOR",
						"class_name": "WorldCoordinator"
					},
					{
						"name": "FORUM_COORDINATOR",
						"class_name": "ForumCoordinator"
					}
				]
			},
			"kv_namespaces": [
				{ "binding": "BICKR_KV", "id": "f153e4189e40485488cbbe0ca4ba91eb" }
			],
			"d1_databases": [
				{
					"binding": "BICKR_D1",
					"database_name": "bickr-test",
					"database_id": "d45193d4-15af-461d-84e7-9f8c276a30f8",
					"migrations_dir": "../../migrations"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "BICKR_SEARCH_VECTORIZE",
					"index_name": "bickr-bot-search-test"
				},
				{
					"binding": "BICKR_BOT_VECTORIZE",
					"index_name": "bickr-bot-search-test"
				}
			],
			"triggers": {
				"crons": ["0 0 * * *"]
			}
		}
	}
}
