// Generated-style, environment-specific Pages configuration used only through
// ops/cloudflare/pages-recreate-test/.wrangler/deploy/config.json. Cloudflare
// requires redirected deployment configs to contain no env blocks.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "bickr",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": ["enable_request_signal"],
	"pages_build_output_dir": "./dist/client",
	"services": [
		{ "binding": "AGENT_RUNTIME", "service": "bickr-agent-runtime-test" },
		{ "binding": "FORUM_COORDINATOR_SERVICE", "service": "bickr-forum-coordinator-test" },
	],
	"durable_objects": {
		"bindings": [
			{ "name": "BOT_RUNTIME", "class_name": "BotRuntime", "script_name": "bickr-agent-runtime-test" },
			{
				"name": "USER_BOTS",
				"class_name": "UserBotsCoordinator",
				"script_name": "bickr-agent-runtime-test",
			},
			{
				"name": "WORLD_COORDINATOR",
				"class_name": "WorldCoordinator",
				"script_name": "bickr-forum-coordinator-test",
			},
			{
				"name": "FORUM_COORDINATOR",
				"class_name": "ForumCoordinator",
				"script_name": "bickr-forum-coordinator-test",
			},
		],
	},
	"kv_namespaces": [{ "binding": "BICKR_KV", "id": "a57182d3ecff4f66a8725f6900f60817" }],
	"d1_databases": [
		{
			"binding": "BICKR_D1",
			"database_name": "bickr-test-v2",
			"database_id": "626f2b02-f546-46d9-85f9-b784868a5338",
			"migrations_dir": "../../migrations",
		},
	],
	"r2_buckets": [{ "binding": "BICKR_R2", "bucket_name": "bickr-avatars-test-v2" }],
	"vars": {
		"BICKR_ENVIRONMENT": "test",
		"BICKR_PRODUCTION_ORIGIN": "https://bickr.social",
		"BICKR_R2_PUBLIC_BASE_URL": "https://test-assets.bickr.social",
		"GITHUB_REDIRECT_URI": "https://test.bickr.social/api/auth/github/callback",
		"GOOGLE_REDIRECT_URI": "https://test.bickr.social/api/auth/google/callback",
		"TEST_AUTH_ALLOWED_HOSTS": "test.bickr.social,test.bickr.pages.dev",
		"TEST_ENTRY_MODE": "migration",
	},
}
