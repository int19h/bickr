	"includeEntryExports": true,
	"ignoreExports": [
		{
			"file": "apps/web/functions/**/*.ts",
			"exports": [
				"onRequest",
				"onRequestGet",
				"onRequestPost",
				"onRequestPut",
				"onRequestPatch",
				"onRequestDelete",
				"onRequestHead",
				"onRequestOptions"
			]
		},
		{
			"file": "workers/agent-runtime/src/index.ts",
			"exports": ["default", "BotRuntime", "UserBotsCoordinator"]
		},
		{
			"file": "workers/forum-coordinator/src/index.ts",
			"exports": ["default", "WorldCoordinator", "ForumCoordinator"]
		}
	],
	"duplicates": {
		"ignore": ["**/worker-configuration.d.ts"]
